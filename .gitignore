# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/

# Configuration and secrets
.env
.env.*
# No space after "!": "! .env.example" negates a pattern with a literal
# leading space, which matches nothing — the file stayed tracked only
# because it was committed before the rule existed.
!.env.example

# Databases, including timestamped backups (*.db alone missed .db.bak-*,
# which is how two database backups ended up committed)
*.db
*.db.bak*
*.sqlite

# Testing / Coverage
.coverage
.coverage.*
.pytest_cache/
htmlcov/
pytest_debug.log

# OS-specific
.DS_Store
Thumbs.db

# Personal / AI Artifacts
implementation_plan.md
task.md
walkthrough.md
instructions.md

# LocalStack Data
volume/

# Raw demo recordings (the rendered demo.gif IS tracked)
media/
data/
