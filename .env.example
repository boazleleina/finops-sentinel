# True means the agent will only log what it would do, but will not actually delete anything.
DRY_RUN=true

# URL to AWS Endpoint. Defaults to LocalStack for local development. Unset this for real AWS.
AWS_ENDPOINT_URL=http://localhost:4566

# Home region: used for region discovery and as the fallback when AWS_REGIONS
# is empty.
AWS_REGION=us-east-1

# Regions to scan. Comma-separated, or "all" to scan every region the account
# has enabled (needs the ec2:DescribeRegions permission). Empty scans only
# AWS_REGION.
#   AWS_REGIONS=us-east-1,eu-west-1,ap-southeast-2
#   AWS_REGIONS=all
AWS_REGIONS=

# Regions are scanned in parallel — wall clock is dominated by per-instance
# CloudWatch calls. Set to 1 to scan them one at a time.
SCAN_MAX_WORKERS=8

# Path to the local SQLite database for finding persistence.
SENTINEL_DB_PATH=.sentinel.db

# Slack Webhook URL for sending outbound alerts to a specific channel
SLACK_WEBHOOK_URL=

# Slack Signing Secret for verifying inbound HTTP requests from interactive buttons
SLACK_SIGNING_SECRET=

# Credentials. These dummy values are what LocalStack expects; replace them
# (or use an IAM role / AWS_PROFILE) when pointing at a real account.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Only flag stopped EC2 instances that have been stopped at least this many days.
STOPPED_EC2_THRESHOLD_DAYS=7

# Only flag EBS snapshots older than this. Snapshots whose source volume has
# been deleted are flagged as orphans regardless of age.
SNAPSHOT_AGE_THRESHOLD_DAYS=30

# LLM Advisor. Ollama runs natively on the host, not in a container: Docker on
# Apple Silicon has no GPU passthrough, so a containerized Ollama is CPU-only.
# Inside the app container use http://host.docker.internal:11434 instead.
# Which backend implements the Advisor port: "ollama" or "template".
# "template" needs no model and is what every failure degrades to anyway.
ADVISOR_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Primary model. The 30b MoE activates ~3B params per token, so it runs at
# roughly 8b latency on a 64GB unified-memory Mac. Drop to qwen3:8b on
# smaller hosts or in CI. Any tag `ollama list` shows works.
OLLAMA_MODEL=qwen3:30b-a3b
OLLAMA_TIMEOUT_SECONDS=30
# Max LLM calls per notify pass, spent on the costliest findings first. Local
# inference takes seconds per finding, so an account with hundreds of findings
# would otherwise make `sentinel scan` run for hours.
ADVISOR_MAX_FINDINGS_PER_SCAN=25

# Idle EC2 detection (metric-inferred, notify-only — never auto-remediated).
EC2_IDLE_OBSERVATION_DAYS=14
EC2_IDLE_CPU_PERCENT=5.0
EC2_IDLE_NETWORK_BYTES=1000000
# Minimum CloudWatch datapoints before an instance can be judged idle.
EC2_IDLE_MIN_DATAPOINTS=24

# Prices are NOT set here. Every AWS rate lives in one file with its source
# cited: src/finops_sentinel/adapters/aws/pricing.py, behind the Pricing port.
# Edit that table to change a price, or add a Pricing adapter to fetch live
# rates from the AWS Price List API without touching any scanner.
