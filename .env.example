# True means the agent will only log what it would do, but will not actually delete anything.
DRY_RUN=true

# URL to AWS Endpoint. Defaults to LocalStack for local development. Unset this for real AWS.
AWS_ENDPOINT_URL=http://localhost:4566

# Home region: used for region discovery and as the fallback when AWS_REGIONS
# is empty.
AWS_REGION=us-east-1

# Regions to scan. Comma-separated, or "all" to scan every region the account
# has enabled (needs the ec2:DescribeRegions permission). Empty scans only
# AWS_REGION.
#   AWS_REGIONS=us-east-1,eu-west-1,ap-southeast-2
#   AWS_REGIONS=all
AWS_REGIONS=

# Regions are scanned in parallel — wall clock is dominated by per-instance
# CloudWatch calls. Set to 1 to scan them one at a time.
SCAN_MAX_WORKERS=8

# Path to the local SQLite database for finding persistence.
#
# docker-compose bind-mounts ./data to /app/data and sets the container's copy
# of this variable to /app/data/sentinel.db, so the default below points at the
# SAME file from the host. Keep it that way: the scanner writes findings and the
# API answers Slack's Approve callbacks, and if those two read different
# databases every approval fails with "cannot be approved" — the callback looks
# up a finding the scanner wrote somewhere else.
SENTINEL_DB_PATH=data/sentinel.db

# Slack Webhook URL for sending outbound alerts to a specific channel
SLACK_WEBHOOK_URL=

# Slack Signing Secret for verifying inbound HTTP requests from interactive buttons
SLACK_SIGNING_SECRET=

# Provenance. The signing secret is app-level, so a valid signature only proves
# the request came through this app — including from a second workspace it was
# installed into. Pin the workspace, and the channels callbacks may come from
# (comma-separated). Unset means unrestricted.
SLACK_TEAM_ID=
SLACK_ALLOWED_CHANNEL_IDS=

# Authority. Who may approve a remediation, comma-separated, as the channel
# names them (Slack usernames, or user ids where usernames are hidden). A
# signature proves the transport; this decides whether the person who clicked
# may delete infrastructure. Empty means anyone who can see the message can
# approve — logged at WARNING on every process that runs without it.
SENTINEL_APPROVERS=

# Credentials. These dummy values are what LocalStack expects; replace them
# (or use an IAM role / AWS_PROFILE) when pointing at a real account.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Only flag stopped EC2 instances that have been stopped at least this many days.
STOPPED_EC2_THRESHOLD_DAYS=7

# Only flag EBS snapshots older than this. Snapshots whose source volume has
# been deleted are flagged as orphans regardless of age.
SNAPSHOT_AGE_THRESHOLD_DAYS=30

# LLM Advisor. Ollama runs natively on the host, not in a container: Docker on
# Apple Silicon has no GPU passthrough, so a containerized Ollama is CPU-only.
# Inside the app container use http://host.docker.internal:11434 instead.
# Which backend implements the Advisor port: "ollama" or "template".
# "template" needs no model and is what every failure degrades to anyway.
ADVISOR_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Primary model. The 30b MoE activates ~3B params per token, so it runs at
# roughly 8b latency on a 64GB unified-memory Mac. Drop to qwen3:8b on
# smaller hosts or in CI. Any tag `ollama list` shows works.
OLLAMA_MODEL=qwen3:30b-a3b
OLLAMA_TIMEOUT_SECONDS=30
# Max LLM calls per notify pass, spent on the costliest findings first. Local
# inference takes seconds per finding, so an account with hundreds of findings
# would otherwise make `sentinel scan` run for hours.
ADVISOR_MAX_FINDINGS_PER_SCAN=25

# Idle EC2 detection (metric-inferred, notify-only — never auto-remediated).
EC2_IDLE_OBSERVATION_DAYS=14
EC2_IDLE_CPU_PERCENT=5.0
EC2_IDLE_NETWORK_BYTES=1000000
# Minimum CloudWatch datapoints before an instance can be judged idle.
EC2_IDLE_MIN_DATAPOINTS=24

# RDS detection. Both RDS rules are notify-only and have NO remediation
# playbook: this agent never deletes a database. It reports; you act.
RDS_IDLE_OBSERVATION_DAYS=14
# Average DatabaseConnections at or below this counts as idle. Raise it if
# monitoring agents or connection poolers hold a permanent baseline open.
RDS_IDLE_MAX_CONNECTIONS=0.0
# Minimum CloudWatch datapoints before a database can be judged idle.
RDS_IDLE_MIN_DATAPOINTS=24
# There is deliberately no RDS_STOPPED_THRESHOLD_DAYS: DescribeDBInstances
# exposes no stopped-since timestamp, and AWS restarts a stopped instance
# after 7 days anyway, so being stopped is itself the finding.

# S3. Below this size, a missing lifecycle policy is not worth an alert.
S3_MIN_BUCKET_SIZE_GB=50
# Multipart uploads older than this are abandoned rather than in flight. Used
# to detect them AND re-checked when the abort playbook runs, so an upload
# started after the alert went out is never touched.
S3_INCOMPLETE_MPU_AGE_DAYS=7
# Share of a bucket's storage cost a lifecycle policy could plausibly recover.
# A bucket without a policy is not wholly waste, and reporting its full cost as
# savings would let one large bucket dominate the total.
S3_LIFECYCLE_ADDRESSABLE_FRACTION=0.20

# Prices are NOT set here. Every AWS rate lives in one file with its source
# cited: src/finops_sentinel/adapters/aws/pricing.py, behind the Pricing port.
# Edit that table to change a price, or add a Pricing adapter to fetch live
# rates from the AWS Price List API without touching any scanner.

# Right-sizing digest (`sentinel digest`). Advisory only — there is no
# playbook that resizes an instance and there will not be one: the change
# needs a stop/start and, for Graviton, a rebuild. It is a deploy, not cleanup.
RIGHTSIZING_OBSERVATION_DAYS=14
# PEAK CPU below this suggests a smaller instance. Peak, never average: a box
# that spikes to 90% once an hour is correctly sized however low its mean is.
# Paired with a candidate list that steps down at most one size — halving vCPU
# roughly doubles utilisation, so a 40% peak lands near 80% on the target.
RIGHTSIZING_CPU_HEADROOM_PERCENT=40.0
# Minimum CloudWatch datapoints before an instance can be called over-sized.
RIGHTSIZING_MIN_DATAPOINTS=24
# Cap on digest suggestions. Readability, not cost — biggest savings sort first.
DIGEST_MAX_ITEMS=10

# Spend anomaly. What is measured is estimated monthly WASTE (the total of
# live findings), not billed spend: there is no billing data in this system
# until a Cost Explorer adapter exists, and every string the tool prints says
# so rather than quietly implying otherwise.
ANOMALY_WINDOW_DAYS=14
# Below this many days of scan history there is no verdict. An anomaly alert
# that fires on three days of data is one people learn to ignore.
ANOMALY_MIN_HISTORY_DAYS=7
# |z| at or above this is an anomaly. 2.0 is roughly the outer 5% of a normal
# distribution — frequent enough to be useful, rare enough to still be read.
ANOMALY_Z_THRESHOLD=2.0
